# HelpScout Configuration
HELPSCOUT_API_KEY=your_helpscout_api_key_here
HELPSCOUT_APP_ID=your_app_id_here
HELPSCOUT_APP_SECRET=your_app_secret_here
HELPSCOUT_WEBHOOK_SECRET=your_webhook_secret_here

# Database
DATABASE_URL=postgresql://helpscout:helpscout@postgres:5432/helpscout_insights

# Redis (for RQ)
REDIS_URL=redis://redis:6379/0

# LLM Provider Configuration
# Options: openai, anthropic, azure_openai
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
# ANTHROPIC_API_KEY=your_anthropic_key
# AZURE_OPENAI_ENDPOINT=your_endpoint
# AZURE_OPENAI_KEY=your_key

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SYNC_INTERVAL_HOURS=6
ANALYSIS_BATCH_SIZE=50
MAX_TICKETS_PER_SYNC=1000

# Initial Sync Configuration
# Sync tickets from this date onward (ISO format: 2024-01-01 or leave empty for all time)
SYNC_START_DATE=
# Maximum tickets to fetch on initial sync (0 = unlimited)
SYNC_INITIAL_LIMIT=0
# Auto-run initial sync on first startup
AUTO_INITIAL_SYNC=true
# Auto-run analysis after sync
AUTO_INITIAL_ANALYSIS=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Analysis Configuration
ANALYSIS_LOOKBACK_DAYS=7
TOP_INSIGHTS_LIMIT=10
ENABLE_EMBEDDINGS=false
# Enable automatic category extraction (statistical analysis)
ENABLE_AUTO_CATEGORIZATION=true
# Minimum occurrences for a category to be included
CATEGORY_MIN_OCCURRENCES=2
